# Tina Cloud (copy to `.env.local` for local dev)
#
# Find this in Tina Cloud dashboard -> Project -> Application IDs
NEXT_PUBLIC_TINA_CLIENT_ID=YOUR_TINA_CLIENT_ID
#
# Create in Tina Cloud dashboard -> Tokens (keep secret; never commit)
TINA_TOKEN=YOUR_TINA_TOKEN
#
# Optional: override Tina branch (defaults to your git branch name)
# TINA_BRANCH=main
